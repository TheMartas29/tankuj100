# Kopíruj jako `be/.env` a doplň hodnoty. Skutečný .env se NEcommituje.
# Server si .env načte sám při startu (nepotřebuje --env-file).

# ------------------------------------------------------------------ základ
# Port, na kterém běží API (musí sedět s nginx proxy a s PM2 configem)
PORT=3000

# Prostředí: development | production
NODE_ENV=development

# Jméno prostředí, které hlásí /api/ping: production | test
# Aplikace podle toho pozná, s kým opravdu mluví (a odmítne se přepnout na test,
# kdyby testovací doména mířila omylem na produkci).
ENV_NAME=production

# Adresa, na které server poslouchá. Výchozí 127.0.0.1 znamená "jen přes nginx".
# Na 0.0.0.0 přepni jen když potřebuješ na API z jiného zařízení v síti.
# HOST=127.0.0.1

# ------------------------------------------------------------------ klíč aplikace
# Sdílený klíč, kterým se hlásí mobilní aplikace (hlavička X-App-Key).
# NENÍ to tajemství – z binárky aplikace ho jde vytáhnout. Odfiltruje boty a curl,
# proti cílenému zneužití nepomůže.
#
# APP_KEY_MODE:
#   off   – klíč se neřeší (výchozí, když APP_KEY není vyplněný)
#   soft  – request bez klíče projde, jen se jednou za hodinu spočítá do logu
#   hard  – request bez klíče dostane 401
#
# Postup při zavádění: nasadit `soft`, vydat verzi aplikace s klíčem, počkat až
# log hlásí nulu, teprve pak přepnout na `hard`.
APP_KEY=
APP_KEY_MODE=off

# Cesta k SQLite databázi (volitelné, výchozí be/db/tankuj100db.sqlite)
# DB_PATH=./db/tankuj100db.sqlite

# ------------------------------------------------------------------ administrace
# Bez těchhle dvou proměnných je administrace VYPNUTÁ (vrací 503).
# Admin běží na / a /admin, admin API na /api/admin/*.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ------------------------------------------------------------------ e-mailové notifikace (EmailJS)
# Stejná služba jako kontaktní formulář na silkroadbrand.eu.
# Hodnoty najdeš v EmailJS dashboardu (Email Services / Email Templates / Account → API keys).
# Když chybí, notifikace se jen zaloguje – hlášení uživatelů se vždycky uloží do DB.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# Private key vyplň jen tehdy, když v EmailJS zapneš "API calls from non-browser
# applications" s vynuceným private key (jinak nechej prázdné).
# EMAILJS_PRIVATE_KEY=

# Origin, který se posílá EmailJS (musí být povolený v jejich nastavení).
# ⚠️ Na testu přepiš na tankuj100-test.silkroadbrand.eu – a ten origin si nezapomeň
# povolit i v EmailJS, jinak odesílání z testu skončí chybou.
EMAILJS_ORIGIN=https://tankuj100.silkroadbrand.eu

# Kam notifikace chodí (předává se šabloně jako to_email; když má šablona
# příjemce natvrdo, nemá tohle efekt)
NOTIFY_EMAIL=

# Odkaz do administrace v těle e-mailu.
# ⚠️ Na testu přepiš na tankuj100-test.silkroadbrand.eu/, jinak by notifikace
# z testu vedly do produkční administrace.
ADMIN_URL=https://tankuj100.silkroadbrand.eu/

# Strop notifikací za hodinu (ochrana schránky proti spamu)
MAIL_MAX_PER_HOUR=30
