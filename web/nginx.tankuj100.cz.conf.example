# tankuj100.cz – nginx server blok pro statický prezentační web (Vite build v dist/).
#
# Pozor: tohle NENÍ blok pro API. Backend (PM2 `tankuj100`) má vlastní konfiguraci
# v deploy/nginx.tankuj100.conf.example a běží na jiné doméně.
#
# 1) Zkopíruj:  sudo cp web/nginx.tankuj100.cz.conf.example /etc/nginx/sites-available/tankuj100.cz
# 2) Aktivuj:   sudo ln -s /etc/nginx/sites-available/tankuj100.cz /etc/nginx/sites-enabled/
#    Test:      sudo nginx -t
#    Reload:    sudo systemctl reload nginx
# 3) HTTPS:     sudo certbot --nginx -d tankuj100.cz -d www.tankuj100.cz
#               (certbot si sem sám doplní listen 443 + certifikáty + redirect z 80)
#
# Až po certbotu – tenhle soubor záměrně zatím poslouchá jen na 80, aby prošel
# `nginx -t` i bez existujících certifikátů.

server {
    listen 80;
    listen [::]:80;
    server_name tankuj100.cz www.tankuj100.cz;

    root /var/www/tankuj100-web/dist;
    index index.html;

    # Komprese – nginx ve výchozím stavu gzipuje jen HTML, ostatní typy se musí vyjmenovat
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json
               image/svg+xml application/xml font/woff2;

    # Bezpečnostní hlavičky
    # HSTS zapni (odkomentuj) až budeš mít funkční HTTPS – jinak si zamkneš doménu na http.
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;

    # Hashované assety z Vite (/assets/app-a1b2c3.js) – název se mění s obsahem,
    # takže je můžeme cachovat natvrdo na rok
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        access_log off;
        try_files $uri =404;
    }

    # Obrázky a ikony z public/ (telefony, og-image, favicon) – tyhle soubory
    # NEJSOU hashované, takže „immutable“ na rok by po přegenerování držel
    # lidem i crawlerům starou verzi. Měsíc je rozumný kompromis.
    location ~* \.(?:webp|png|jpe?g|gif|svg|ico|mp4)$ {
        expires 30d;
        add_header Cache-Control "public" always;
        access_log off;
    }

    # index.html se nesmí cachovat, jinak lidem zůstane odkaz na starý build
    location = /index.html {
        add_header Cache-Control "no-cache" always;
    }

    # Certbot – ověření vlastnictví domény (rsync v deploy_prod.sh tuhle složku nemaže)
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/tankuj100-web/dist;
        default_type "text/plain";
    }

    # --- Kampaňová adresa ---------------------------------------------------
    #
    # tankuj100.cz/stahnout servíruje **stejnou stránku jako /**. Návštěvník tedy
    # vidí normální web a v adresním řádku čistou adresu bez parametrů; nikam se
    # nepřesměrovává. Vedle toho nginx pošle `mirror` požadavek na backend, který
    # návštěvu započítá.
    #
    # `mirror` běží **mimo** odpověď návštěvníkovi: nečeká se na něj a jeho výsledek
    # se zahazuje. Když backend leží nebo je pomalý, stránka se doručí normálně –
    # jen se ta návštěva nezapočítá. To je záměr: měření nesmí shodit web.
    #
    # POZOR: `add_header` uvnitř `location` ruší dědění hlaviček ze serverového
    # bloku, proto se tu ty bezpečnostní opakují. Bez toho by tahle jediná adresa
    # tiše přišla o nosniff, X-Frame-Options i Referrer-Policy.
    location = /stahnout {
        mirror /__visit;

        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;
        add_header Cache-Control "no-cache" always;
        # Je to obsahově tatáž stránka jako `/`, takže ať si ji Google neindexuje
        # podruhé jako duplicitu. `follow` znamená, že odkazy z ní pořád sleduje.
        add_header X-Robots-Tag "noindex, follow" always;

        try_files /index.html =404;
    }

    # Interní: zvenčí se sem nedá dostat. Token musí sedět s VISIT_TOKEN v be/.env,
    # jinak backend návštěvu zahodí (a bez tokenu v .env se nepočítá vůbec).
    location = /__visit {
        internal;
        proxy_pass http://127.0.0.1:3000/api/visit/?path=/stahnout;
        proxy_set_header X-Visit-Token "ZDE_VISIT_TOKEN";
        proxy_set_header User-Agent $http_user_agent;
        proxy_set_header Referer $http_referer;
        # Backend má `trust proxy`, takže z tohohle přečte skutečnou IP návštěvníka.
        # Neukládá ji – používá ji jen jako vstup do denního otisku.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Host $host;
    }

    # Web je jednostránkový a nemá klientský router, takže se tu záměrně
    # NEDĚLÁ SPA fallback na index.html – neexistující adresa musí vrátit
    # poctivou 404. Kdyby vracela obsah se stavem 200, Google to bere jako
    # „soft 404“ a zhoršuje si tím důvěru v celý web.
    location / {
        try_files $uri $uri/ =404;
    }
}
